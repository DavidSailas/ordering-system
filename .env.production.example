# =========================================================================================================
# LIVE SITE settings for Cecilian Bites. Copy the values you need into the hosting dashboard (or the live
# server's .env). Never commit the real .env file, and never share it (it contains passwords and keys).
# After changing anything run:   php artisan config:clear   and then   php artisan canteen:preflight
# =========================================================================================================

APP_NAME="Cecilian Bites"
APP_ENV=production
APP_DEBUG=false                       # MUST be false: when something breaks, visitors must not see code or settings
APP_KEY=                              # php artisan key:generate --show   (keep it secret, keep it the same)
APP_URL=https://your-canteen.example.com
APP_TIMEZONE=Asia/Manila              # otherwise every time on screen is 8 hours behind

LOG_LEVEL=warning

# A real database for the live site (SQLite is fine for a demo only).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true            # cookies only travel over https
SESSION_SAME_SITE=lax

# Sign-up codes are emailed. MAIL_MAILER=log only writes them to a file, which is for testing.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=                        # a Google "App Password", not the normal Gmail password
MAIL_FROM_ADDRESS="canteen@your-school.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Nothing in the code reads these two; leave them empty / false.
ADMIN_REGISTRATION_CODE=
PUBLIC_STAFF_REGISTRATION=false

# Where customers send GCash / Maya payments (each canteen can also set its own under Admin -> Settings).
STORE_GCASH_NUMBER=
STORE_GCASH_NAME=
STORE_MAYA_NUMBER=
STORE_MAYA_NAME=

# Ordering rules (defaults shown)
ORDER_UNPAID_EXPIRY_MINUTES=15
ORDER_UNPAID_REVIEW_MINUTES=60
ORDER_STRIKES_MAX=3
ORDER_STRIKES_PAUSE_DAYS=3
ORDER_STRIKES_WINDOW_DAYS=30
ORDER_REQUIRE_SCHOOL_ID=false
