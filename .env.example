APP_NAME="Cecilian Bites"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The canteen is in the Philippines: with UTC every time on screen is 8 hours behind.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Registration sends a 6-digit code by email. With MAIL_MAILER=log the code is only written to
# storage/logs/laravel.log (fine for local testing). For real emails use smtp, e.g. Gmail:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<16-char Google App Password>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Currency is fixed to the peso (₱) in config/restaurant.php - no env setting needed.
ADMIN_REGISTRATION_CODE=
PUBLIC_STAFF_REGISTRATION=false

# Customer online payments — the store accounts customers send GCash/Maya payments to.
# A method with no number is hidden. Optional QR images: public/payment-qr/gcash.png and maya.png
STORE_GCASH_NUMBER=
STORE_GCASH_NAME=
STORE_MAYA_NUMBER=
STORE_MAYA_NAME=

# ---------------------------------------------------------------------------------------------------------
# Ordering rules (the defaults are shown; every one can be left out)
# ---------------------------------------------------------------------------------------------------------
# Pay first, then we cook: an unpaid order cancels itself after this many minutes. When the customer has
# already sent a GCash / Maya reference the cashier gets longer to check it.
ORDER_UNPAID_EXPIRY_MINUTES=15
ORDER_UNPAID_REVIEW_MINUTES=60

# Missed orders: after STRIKES_MAX unpaid orders a phone number or school ID is paused for PAUSE_DAYS
# (it lifts by itself). Missed orders older than WINDOW_DAYS are forgotten. 0 switches strikes off.
ORDER_STRIKES_MAX=3
ORDER_STRIKES_PAUSE_DAYS=3
ORDER_STRIKES_WINDOW_DAYS=30

# Customers must tap / scan their school ID (plus last name) to order. The administrator can also switch
# this on or off under Admin -> Order security; that switch wins over this value.
ORDER_REQUIRE_SCHOOL_ID=false

# Behind a hosting proxy (Railway) leave this out. To trust only certain proxies, list them, comma separated.
# TRUSTED_PROXIES=

